# ==============================================================================
# GURUKU B2B SAAS - ENVIRONMENT VARIABLES CONFIGURATION TEMPLATE
# ==============================================================================

# --- FRONTEND ENVIRONMENT CONFIGURATION (Vite / Vercel) ---
# VITE_API_BASE_URL: URL REST API Backend.
# Jika kosong, frontend akan menggunakan relative path (/api/v1/...) via Vercel proxy.
VITE_API_BASE_URL=

# VITE_WS_BASE_URL: URL Server WebSocket Daemon Go Persisten (misal Railway, Fly.io, VPS).
# CATATAN ARSITEKTUR: Vercel Serverless TIDAK mendukung WebSocket persisten!
# Kosongkan variabel ini saat deploy di Vercel agar aplikasi otomatis menggunakan fallback SSE / Polling.
# Isi hanya jika Anda menjalankan backend Go persisten di server terpisah.
# Contoh: wss://ws.guruku.id atau ws://localhost:8080
VITE_WS_BASE_URL=

# --- BACKEND ENVIRONMENT CONFIGURATION (Go Core & Vercel API) ---
# DATABASE_URL: PostgreSQL Connection String (Neon Serverless Postgres dengan pgbouncer pooler)
# Format: postgres://username:password@ep-cool-sample.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# JWT_SECRET: Kunci rahasia HMAC-SHA256 untuk menandatangani cookie sesi guruku_jwt
JWT_SECRET=super-secret-saas-key-change-in-production

# PORT: Port server Go lokal/daemon (default: 8080)
PORT=8080

# GIN_MODE: Mode Gin runtime (debug | release)
GIN_MODE=release
